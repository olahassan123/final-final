# Environment Variables for MeDay Backend

# Choose chat mode: "hardcoded", "ollama", or "groq"
CHAT_MODE=hardcoded

# Groq API Key (only needed if CHAT_MODE=groq)
# Get from: https://console.groq.com/
GROQ_API_KEY=your_api_key_here

# Ollama settings (only needed if CHAT_MODE=ollama)
# Make sure Ollama is running: ollama serve
# Model to use: mistral, llama2, etc.
OLLAMA_MODEL=mistral
OLLAMA_BASE_URL=http://localhost:11434
