# Environment Variables for MeDay Backend

# Ollama is the primary provider. OpenAI and Groq are optional fallbacks.
OLLAMA_ENABLED=true
OLLAMA_MODEL=qwen3:4b-instruct
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_TIMEOUT_SECONDS=120

# OpenAI external AI provider, using the Responses API.
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-5.6-terra
OPENAI_REASONING_EFFORT=low
OPENAI_INCLUDE_TEMPERATURE=false
OPENAI_TIMEOUT_SECONDS=8

# Groq API Key (only needed if CHAT_MODE=groq)
# Get from: https://console.groq.com/
GROQ_API_KEY=your_api_key_here
# Optional: change this if Groq deprecates a model, without editing code.
GROQ_MODEL=openai/gpt-oss-20b
